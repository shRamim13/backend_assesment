{
  "name": "category-api",
  "version": "1.0.0",
  "description": "Category Management REST API — unlimited nesting, Redis caching",
  "main": "dist/app.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "clean": "rm -rf dist",
    "test": "jest --runInBand",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up -d",
    "docker:stop": "docker-compose -f docker-compose.dev.yml down",
    "docker:full": "docker-compose up --build"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.3.0",
    "express": "^4.18.0",
    "mongoose": "^7.6.0",
    "redis": "^4.6.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.0"
  }
}
